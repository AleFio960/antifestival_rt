{
  "info": {
    "_postman_id": "3fd80178-5a8c-46db-b4ef-7a3c7db1fe0f",
    "name": "FatturaPRO - saveDocument esempi",
    "description": "Esempi POST x-www-form-urlencoded per saveDocument. La collection non contiene api-key: valorizzare la variabile api_key in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "pm.variables.set('today', now.toISOString().slice(0, 10));",
          "pm.variables.set('unique_id', String(now.getTime()));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP 200', function () {",
          "  pm.response.to.have.status(200);",
          "});",
          "",
          "let parsed = null;",
          "pm.test('Risposta XML leggibile', function () {",
          "  parsed = xml2Json(pm.response.text());",
          "  pm.expect(parsed).to.have.property('result');",
          "  pm.expect(parsed.result).to.have.property('returnCode');",
          "});",
          "",
          "if (parsed && parsed.result) {",
          "  pm.environment.set('last_saveDocument_returnCode', parsed.result.returnCode);",
          "  if (parsed.result.token) {",
          "    pm.environment.set('last_saveDocument_token', parsed.result.token);",
          "  }",
          "  if (parsed.result.link) {",
          "    pm.environment.set('last_saveDocument_link', parsed.result.link);",
          "  }",
          "  console.log('saveDocument returnCode:', parsed.result.returnCode);",
          "  console.log('saveDocument description:', parsed.result.description);",
          "}"
        ]
      }
    }
  ],
